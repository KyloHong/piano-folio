# ============================================================
#  环境变量配置 —— Vercel 部署请在 Vercel 控制台配置，本地开发复制为 .env
# ============================================================

# 服务端口（本地开发用，Vercel 不需要设置）
PORT=3000

# JWT 签名密钥（必填，建议使用随机字符串，不低于 32 字符）
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Turso 数据库（云端 SQLite）
# 注册地址: https://turso.tech
# 创建数据库后，在 Turso 控制台复制 Database URL 和 Auth Token
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token
